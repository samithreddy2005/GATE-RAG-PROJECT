# Copy this file to .env and fill in your own values.
# .env is gitignored and must never be committed.

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Any chat model your Groq key can access, e.g.
#   openai/gpt-oss-120b, openai/gpt-oss-20b, llama-3.3-70b-versatile
GENERATION_MODEL=openai/gpt-oss-120b

# Reasoning models spend a large share of their budget on internal reasoning
# before emitting visible text. Too low a limit truncates a derivation before
# it reaches its "FINAL ANSWER:" line, which then looks like a wrong answer
# rather than a cut-off one. 4096 is a safe floor for gpt-oss.
GENERATION_MAX_TOKENS=4096

# Low temperature: derivations should be reproducible, not creative.
GENERATION_TEMPERATURE=0.2
